---
import { SITE } from '../lib/site';
import Stripe from './Stripe.astro';
---

<footer class="foot-wrap">
  <div class="foot wrap">
    <span class="t-label"><span class="dash">{SITE.name}</span> {SITE.year}</span>
    <span class="t-label t-muted keys">Keys <kbd>0</kbd><kbd>1</kbd><kbd>2</kbd></span>
  </div>
  <Stripe />
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    margin-left: 0.4em;
    padding: 0.1em 0.3em;
    border: 1px solid currentColor;
    font: inherit;
    letter-spacing: 0;
  }
  @media (hover: none) { .keys { display: none; } }
</style>
