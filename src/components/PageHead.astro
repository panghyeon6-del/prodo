---
// 하위 페이지 공통 머리: 번호 / 큰 제목 / 부제
import type { Route } from '../lib/site';
interface Props { route: Route }
const { route } = Astro.props;
---

<section class="head">
  <span class="t-label head-no">{route.no}</span>
  <h1 class="t-display head-title" data-reveal>{route.label}<span class="head-bar" aria-hidden="true"></span></h1>
  <p class="t-label head-sub">{route.sub}</p>
</section>

<style>
  .head {
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .head-title { display: flex; align-items: center; gap: 0.15em; }
  .head-bar {
    display: inline-block;
    width: 0.9em;
    height: 0.06em;
    margin-left: 0.2em;
    background: currentColor;
  }
</style>
