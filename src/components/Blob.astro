---
// 수채 번짐 덩어리 — 그림의 물감 얼룩. #wc 필터로 가장자리가 거칠게 번지고 입자가 생긴다.
// 색은 color 로, 위치·크기는 부모가 .부모 :global(.클래스) 로 정한다.
const SHAPES = {
  a: 'M100 14C146 10 186 44 188 94 190 146 150 188 98 186 48 184 12 150 12 100 12 52 52 18 100 14Z',
  b: 'M92 10C140 2 192 30 190 86 188 130 168 176 112 188 58 198 8 166 10 110 12 62 44 18 92 10Z',
  c: 'M60 20C102 -4 168 12 184 64 200 116 176 178 112 186 54 194 6 158 14 100 18 66 30 38 60 20Z',
};
interface Props { shape?: keyof typeof SHAPES; color?: string; class?: string }
const { shape = 'a', color = 'var(--pink)', class: cls } = Astro.props;
---

<svg class:list={['blob', cls]} viewBox="0 0 200 200" aria-hidden="true" style={`color:${color}`}>
  <path d={SHAPES[shape]} />
</svg>

<style>
  .blob {
    max-width: none;
    overflow: visible;
    fill: currentColor;
    filter: url(#wc);
    pointer-events: none;
  }
</style>
