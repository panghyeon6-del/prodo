---
// 사진이 들어갈 자리. 나중에 <Image> 로 교체한다.
// ratio 로 비율을 잡아두면 사진을 넣어도 레이아웃이 밀리지 않는다(CLS 0).
interface Props {
  ratio?: string;          // '16/9', '4/5', '1/1' …
  label?: string;          // 박스 안 라벨
  tone?: 'paper' | 'ink' | 'red';
  class?: string;
}
const { ratio = '4/3', label = 'Image', tone = 'paper', class: cls } = Astro.props;
---

<figure class:list={['ph', `ph--${tone}`, cls]} style={`aspect-ratio:${ratio}`} data-reveal>
  <svg class="ph-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="0" x2="100" y2="100" />
    <line x1="100" y1="0" x2="0" y2="100" />
  </svg>
  <figcaption class="t-label ph-label">{label} — {ratio}</figcaption>
  <slot />
</figure>

<style>
  .ph {
    position: relative;
    width: 100%;
    background: var(--paper-2);
    overflow: hidden;
  }
  .ph--ink { background: var(--ink); color: var(--white); }
  .ph--red { background: var(--red); color: var(--white); }

  .ph-x {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.12;
  }
  .ph-x line { vector-effect: non-scaling-stroke; }

  .ph-label {
    position: absolute;
    left: 1rem;
    top: 1rem;
    opacity: 0.6;
  }
</style>
