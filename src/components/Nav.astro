---
// 상단 고정 내비게이션.
// 왼쪽 빨간 네모 = 대표 이미지이자 홈 버튼. 오른쪽 타일 3개 = 하위 페이지.
// 키보드 0~3 으로도 이동(scripts/motion.ts).
import { NAV_ROUTES, url, type Route } from '../lib/site';

interface Props { current: Route['key'] }
const { current } = Astro.props;
---

<header class="nav sketch-b" style="--sk: var(--line)" transition:persist="nav" transition:name="nav" transition:animate="none">
  <a class="home" href={url('/')} aria-label="홈으로" data-route="home"
     aria-current={current === 'home' ? 'page' : undefined}>
    <span class="home-square" aria-hidden="true"></span>
  </a>

  <nav aria-label="주요 페이지">
    <ul class="tiles">
      {NAV_ROUTES.map((r) => (
        <li>
          <a
            class="tile"
            href={url(r.path)}
            aria-current={r.key === current ? 'page' : undefined}
            data-route={r.key}
          >
            <span class="t-label tile-label">{r.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // ClientRouter 로 nav 가 유지되므로 현재 표시를 이동마다 갱신
  document.addEventListener('astro:page-load', () => {
    const key = document.body.dataset.route;
    document.querySelectorAll<HTMLAnchorElement>('.nav [data-route]').forEach((a) => {
      if (a.dataset.route === key) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  });
</script>

<style>
  .nav {
    --h: var(--nav-h);
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: stretch;
    height: var(--h);
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    background: var(--paper);
  }

  /* ── 홈: 빨간 네모 ─────────────────────────── */
  .home {
    display: grid;
    place-items: center;
    width: calc(var(--h) + 0.75rem);
    flex: none;
    margin-left: calc(var(--gutter) - (var(--h) + 0.75rem - 1.125rem) / 2);
  }
  .home-square {
    width: 1.125rem;
    aspect-ratio: 1;
    background: var(--red);
    -webkit-mask: url('../assets/sketch/fill.svg') 0 0 / 100% 100% no-repeat;
  mask: url('../assets/sketch/fill.svg') 0 0 / 100% 100% no-repeat;
    transition: transform var(--dur) var(--ease-spring), border-radius var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .home:hover .home-square { transform: rotate(-12deg) scale(1.12); }
  }
  .home:active .home-square { transform: scale(0.86); }
  .home[aria-current='page'] .home-square { transform: rotate(45deg) scale(0.8); }

  /* ── 타일 ───────────────────────────────────── */
  nav { margin-left: auto; height: 100%; }
  .tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    height: 100%;
    width: min(26rem, 46vw);
    margin-right: calc(var(--gutter) - 1rem);
  }
  .tile {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 1rem;
    overflow: hidden;
    isolation: isolate;
    transition: color var(--dur-fast) linear;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 3px 0;
    z-index: -1;
    background: var(--ink);
    -webkit-mask: url('../assets/sketch/fill.svg') 0 0 / 100% 100% no-repeat;
  mask: url('../assets/sketch/fill.svg') 0 0 / 100% 100% no-repeat; /* 손으로 칠한 면 */
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .tile:hover { color: var(--white); }
    .tile:hover::before { transform: scaleY(1); }
  }
  .tile[aria-current='page'] { color: var(--white); }
  .tile[aria-current='page']::before { background: var(--red); transform: scaleY(1); }

  /* ── 태블릿 이하 ───────────────────────────── */
  @media (max-width: 760px) {
    .home { width: var(--h); margin-left: calc(var(--gutter) - (var(--h) - 1rem) / 2); }
    .tiles { margin-right: 0; }
    .home-square { width: 1rem; }
    nav { flex: 1; }
    .tiles { width: 100%; }
    .tile { justify-content: center; padding: 0 0.5rem; }
    .tile-label { letter-spacing: 0.12em; }
  }
</style>
