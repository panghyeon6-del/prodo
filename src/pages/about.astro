---
// 소개 — "레이아웃을 부수는 하나": 격자를 무시하고 화면 밖까지 걸치는 거대한 대표 이미지.
// 지금은 빨간 네모. 나중에 사진으로 교체(.big 안에 <Image>).
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { getRoute } from '../lib/site';

const route = getRoute('about');

const pillars = [
  { no: '01', title: 'Values', body: '무엇을 중요하게 여기는지 적는 자리. 두세 문장 정도가 읽기 좋습니다.' },
  { no: '02', title: 'Habits', body: '매일 반복하는 작은 일들. 시스템이 동기를 이긴다는 믿음에 대해.' },
  { no: '03', title: 'Mindset', body: '일을 대하는 태도. 어떤 질문을 스스로에게 던지는지.' },
];

const contacts = [
  { label: 'Email', value: 'hello@example.com', href: 'mailto:hello@example.com' },
  { label: 'Instagram', value: '@username', href: '#' },
  { label: 'YouTube', value: '@channel', href: '#' },
];
---

<Base route="about" title="About">
  <div data-page="about">
    <section class="hero wrap">
      <p class="t-label kicker"><span class="dash">{route.no}</span> {route.label} — {route.ko}</p>
      <h1 class="mega" data-mega>
        <span class="mega-line">About</span>
        <span class="mega-line">Me<span class="mega-bar" aria-hidden="true"></span></span>
      </h1>

      <figure class="big" data-big data-dark aria-label="대표 이미지 자리">
        <span class="t-label big-label">Portrait — 사진 교체 예정</span>
        <span class="big-no" aria-hidden="true">/01</span>
      </figure>

      <div class="sticker" aria-hidden="true">
        <Doodle shape="circle" class="sticker-ring" stretch draw />
        <span class="t-label">It's me</span>
      </div>
    </section>

    <section class="intro wrap">
      <p class="t-label t-muted" data-reveal>{route.sub}</p>
      <p class="statement" data-reveal>
        작은 걸음이 쌓여 체계가 되고, 체계가 더 나은 내일을 만든다고 믿습니다.
        그림·사진·영상으로{' '}
        <span class="mark">기록하고<Doodle shape="underline" class="mark-line" stretch draw /></span>{' '}
        돌아보고 다시 만듭니다.
      </p>
    </section>

    <section class="pillars wrap">
      {pillars.map((p) => (
        <article class="pillar" data-reveal>
          <span class="t-label">{p.no}</span>
          <h2 class="t-title">{p.title}</h2>
          <p>{p.body}</p>
        </article>
      ))}
    </section>

    <section class="contact wrap">
      <h2 class="t-label t-muted">Contact</h2>
      <ul>
        {contacts.map((c) => (
          <li>
            <a href={c.href} class="contact-link" data-reveal>
              <span class="t-label">{c.label}</span>
              <span class="contact-value">{c.value}</span>
              <span class="contact-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import type { MotionEvent } from '../scripts/motion';

  document.addEventListener('motion:ready', (e) => {
    const root = document.querySelector<HTMLElement>('[data-page="about"]');
    if (!root) return;
    const { gsap, reduced } = (e as MotionEvent).detail;
    if (reduced) return;

    const big = root.querySelector('[data-big]')!;
    gsap.timeline({ defaults: { ease: 'expo.out' } })
      .from('.mega-line', { yPercent: 100, duration: 1.1, stagger: 0.1 })
      .from(big, { clipPath: 'inset(100% 0 0 0)', duration: 1.2 }, 0.15)
      .from('.mega-bar', { scaleX: 0, transformOrigin: 'left', duration: 0.8 }, 0.6);

    // 스크롤하면 거대한 네모가 천천히 바로 서며 위로 밀려남
    gsap.to(big, {
      yPercent: -12,
      rotate: 0,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.mega', {
      xPercent: -6,
      ease: 'none',
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
    });
  });
</script>

<style>
  /* ── 히어로: 격자를 부수는 영역 ─────────── */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    padding-block: clamp(1.5rem, 4svh, 3rem);
    overflow: clip;
    isolation: isolate;
  }
  .kicker { position: relative; z-index: 3; }

  .mega {
    position: relative;
    z-index: 2;
    margin-top: clamp(1rem, 4svh, 3rem);
    font-size: min(var(--fs-mega), 30svh);
    font-weight: var(--w-display);
    letter-spacing: -0.06em;
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }
  .mega-line { display: block; clip-path: inset(-0.2em -0.1em 0 -0.1em); }
  .mega-bar {
    display: inline-block;
    width: 0.7em;
    height: 0.07em;
    margin-left: 0.15em;
    vertical-align: 0.28em;
    background: currentColor;
  }

  .big {
    position: absolute;
    z-index: 1;
    right: -9vw;
    top: 8%;
    width: min(58vw, 92svh);
    aspect-ratio: 4 / 5;
    background: var(--red);
    color: var(--white);
    rotate: -4deg;
  }
  .big-label { position: absolute; left: 1.25rem; top: 1.25rem; }
  @media (min-width: 901px) {
    /* 타이틀에 가리지 않게 라벨은 아래쪽 오른편 */
    .big-label { top: 45%; left: 3rem; }
    .big-no { bottom: auto; top: 1rem; left: auto; right: 12vw; }
  }
  .big-no {
    position: absolute;
    left: 1.25rem;
    bottom: 0.5rem;
    font-size: clamp(4rem, 12vw, 12rem);
    font-weight: var(--w-text);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .sticker {
    position: absolute;
    z-index: 3;
    left: 40%;
    bottom: 12%;
    display: grid;
    place-items: center;
    width: 8.5rem;
    aspect-ratio: 1.4;
    rotate: -8deg;
  }
  .sticker :global(.sticker-ring) { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--ink); }

  /* ── 소개 문장 ──────────────────────────── */
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    padding-block: clamp(4rem, 12vw, 10rem) clamp(3rem, 8vw, 6rem);
  }
  .intro > :first-child { grid-column: 1 / span 3; }
  .statement {
    grid-column: 4 / -1;
    font-size: clamp(1.5rem, 3.4vw, 3.157rem);
    font-weight: var(--w-text);
    line-height: 1.25;
    letter-spacing: -0.025em;
    max-width: 24em;
  }
  .mark { position: relative; white-space: nowrap; }
  .mark :global(.mark-line) {
    position: absolute;
    left: -2%;
    bottom: -0.18em;
    width: 104%;
    height: 0.3em;
    color: var(--red);
  }

  /* ── 세 기둥 ────────────────────────────── */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .pillar {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 2rem 2rem 3rem 0;
  }
  .pillar + .pillar { border-left: 1px solid var(--line); padding-left: 2rem; }
  .pillar p { max-width: 28em; }

  /* ── 연락처 ─────────────────────────────── */
  .contact {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .contact ul { list-style: none; }
  .contact-link {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .contact-value {
    font-size: var(--fs-title);
    font-weight: var(--w-title);
    letter-spacing: var(--ls-title);
    overflow-wrap: anywhere;
  }
  .contact-arrow { font-size: 1.5rem; transition: transform var(--dur) var(--ease-spring); }
  @media (hover: hover) {
    .contact-link:hover { color: var(--red); }
    .contact-link:hover .contact-arrow { transform: translateX(0.5rem) rotate(-45deg); }
  }

  /* ── 태블릿 ─────────────────────────────── */
  @media (max-width: 900px) {
    .hero { min-height: auto; padding-bottom: 0; }
    .mega { font-size: 26vw; }
    .big {
      position: relative;
      right: auto;
      top: auto;
      width: calc(100% + 2 * var(--gutter) + 6vw);
      margin: 2vw 0 0;
      margin-inline-start: calc(-1 * var(--gutter) - 3vw);
      rotate: -3deg;
      aspect-ratio: 4 / 4.4;
    }
    .big-label { left: calc(var(--gutter) + 4vw); top: 2rem; }
    .sticker { left: auto; right: 7%; bottom: 10%; width: 7rem; color: var(--white); }
    .sticker :global(.sticker-ring) { color: var(--white); }
    .intro > :first-child, .statement { grid-column: 1 / -1; }
    .pillars { grid-template-columns: 1fr; }
    .pillar, .pillar + .pillar { border-left: 0; padding: 1.75rem 0; }
    .pillar + .pillar { border-top: 1px solid var(--line); }
    .contact-link { grid-template-columns: 1fr auto; }
    .contact-link .t-label { grid-column: 1 / -1; }
  }
</style>
