---
// 랜딩 = 소개. 한 화면, 한 가지 일: "나"를 보여주고 연락할 길을 연다.
// 글은 이름 · 한 줄 소개 · 연락처만. 나머지는 그림이 말한다.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import Stripe from '../components/Stripe.astro';
import { CONTACTS } from '../lib/site';
import me from '../assets/me.jpg';

const name = '프로도';
const email = CONTACTS.find((c) => c.copy)!;
---

<Base route="home" footer={false} title={name} description="프로도 — 모닥불 위 벽화 제작자.">
  <section class="land" data-page="home">
    <!-- 왼쪽: 이름 + 한 줄 -->
    <div class="who">
      <h1 class="name" aria-label={name}>
        <span class="line" aria-hidden="true">
          {[...name].map((c) => <span class="ch">{c}</span>)}
        </span>
      </h1>
      <p class="intro">
        <Doodle shape="flame" class="flame" />
        모닥불 위 벽화 제작자
      </p>
    </div>

    <!-- 가운데: 대표 이미지 -->
    <figure class="frame" data-frame>
      <div class="art" data-art>
        <Image src={me} alt="프로도 자화상 — 곱슬머리에 흰 티셔츠, 펜을 든 그림" widths={[480, 720, 1000, 1400]}
               sizes="(max-width: 760px) 80vw, 30vw" loading="eager" fetchpriority="high" />
      </div>
      <span class="cross c1" aria-hidden="true"></span>
      <span class="cross c2" aria-hidden="true"></span>
      <span class="cross c3" aria-hidden="true"></span>
      <span class="cross c4" aria-hidden="true"></span>
      <span class="hello" data-hello aria-hidden="true">
        <Doodle shape="bubble" class="hello-bubble" />
        <span class="hello-text">Hellow!</span>
      </span>
    </figure>

    <!-- 오른쪽: 연락 -->
    <div class="reach">
      <ul class="contacts sketch-t" aria-label="연락처">
        {CONTACTS.map((c) => (
          <li>
            {c.copy ? (
              <button class="row sketch-b" type="button" data-copy={c.value}>
                <span class="t-label">{c.label}</span>
                <span class="row-val">{c.value}</span>
                <span class="row-end t-label" data-copy-state>Copy</span>
              </button>
            ) : (
              <a class="row sketch-b" href={c.href} target="_blank" rel="noopener">
                <span class="t-label">{c.label}</span>
                <span class="row-val">{c.value}</span>
                <span class="row-end" aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))}
      </ul>
      <a class="cta sketch-fill" href={email.href} data-cta data-dark>
        <span class="t-label">Let's connect</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <Stripe />
</Base>

<script>
  import type { MotionEvent } from '../scripts/motion';

  document.addEventListener('motion:ready', (e) => {
    const root = document.querySelector<HTMLElement>('[data-page="home"]');
    if (!root) return;
    const { gsap, reduced, cleanup } = (e as MotionEvent).detail;

    /* 이메일 복사 */
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const state = btn.querySelector<HTMLElement>('[data-copy-state]')!;
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          state.textContent = 'Copied ✓';
        } catch {
          window.location.href = `mailto:${btn.dataset.copy}`;
        }
        btn.classList.add('is-copied');
        window.setTimeout(() => { state.textContent = 'Copy'; btn.classList.remove('is-copied'); }, 1600);
      }),
    );

    /* 그림을 누르면 몸을 흔들며 인사 */
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const art = root.querySelector<HTMLElement>('[data-art]')!;
    const hello = root.querySelector<HTMLElement>('[data-hello]')!;
    gsap.set(hello, { autoAlpha: 0, scale: 0.4 });
    const wave = () => {
      if (!reduced) {
        gsap.fromTo(art, { rotate: 0 }, {
          keyframes: { rotate: [0, -4, 3, -2, 1, 0] }, duration: 1, ease: 'sine.inOut',
          transformOrigin: '50% 100%', overwrite: 'auto',
        });
      }
      gsap.timeline()
        .to(hello, { autoAlpha: 1, scale: 1, rotate: -6, duration: 0.5, ease: 'back.out(3)' })
        .to(hello, { autoAlpha: 0, scale: 0.6, duration: 0.3, delay: 1.2 });
    };
    frame.addEventListener('click', wave);

    if (reduced) return;

    /* 등장 */
    const chars = gsap.utils.toArray<HTMLElement>('.ch', root);
    const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
    intro
      .from(chars, { yPercent: 110, duration: 1.1, stagger: 0.07 })
      .from(art, { clipPath: 'inset(100% 0% 0% 0%)', duration: 1.2 }, 0.1)
      .from('.cross', { scale: 0, rotate: 90, duration: 0.7, stagger: 0.06, ease: 'back.out(2)' }, 0.5)
      .from('.intro', { y: 14, autoAlpha: 0, duration: 0.8 }, 0.6)
      .from('.flame path', { strokeDasharray: 1, strokeDashoffset: 1, duration: 0.9, stagger: 0.15, ease: 'power2.inOut' }, 0.8)
      .from(['.contacts li', '.cta'], { y: 18, autoAlpha: 0, duration: 0.7, stagger: 0.07 }, 0.7)
      .add(wave, 1.5);

    /* 마우스: 그림이 커서 쪽으로 기울고 / 이름은 살짝 들림 / 버튼은 끌려옴 */
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    gsap.set(art, { transformPerspective: 900 });
    const rx = gsap.quickTo(art, 'rotationX', { duration: 0.6, ease: 'power3.out' });
    const ry = gsap.quickTo(art, 'rotationY', { duration: 0.6, ease: 'power3.out' });
    const setters = chars.map((c) => ({ el: c, y: gsap.quickTo(c, 'y', { duration: 0.5, ease: 'power3.out' }) }));
    const cta = root.querySelector<HTMLElement>('[data-cta]')!;
    const mx = gsap.quickTo(cta, 'x', { duration: 0.5, ease: 'power3.out' });
    const my = gsap.quickTo(cta, 'y', { duration: 0.5, ease: 'power3.out' });

    const onMove = (ev: PointerEvent) => {
      if (intro.isActive()) return;
      const f = frame.getBoundingClientRect();
      const nx = (ev.clientX - (f.left + f.width / 2)) / window.innerWidth;
      const ny = (ev.clientY - (f.top + f.height / 2)) / window.innerHeight;
      ry(nx * 14); rx(-ny * 10);

      for (const s of setters) {
        const b = s.el.getBoundingClientRect();
        const d = Math.hypot(ev.clientX - (b.left + b.width / 2), ev.clientY - (b.top + b.height / 2));
        s.y(-Math.max(0, 1 - d / 200) * b.height * 0.12);
      }

      const c = cta.getBoundingClientRect();
      const dx = ev.clientX - (c.left + c.width / 2);
      const dy = ev.clientY - (c.top + c.height / 2);
      const near = Math.abs(dx) < c.width / 2 + 60 && Math.abs(dy) < c.height / 2 + 60;
      mx(near ? dx * 0.18 : 0);
      my(near ? dy * 0.3 : 0);
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    cleanup(() => window.removeEventListener('pointermove', onMove));

    chars.forEach((c) =>
      c.addEventListener('click', () =>
        gsap.fromTo(c, { y: 0 }, { keyframes: { y: [0, -40, 0, -10, 0], rotate: [0, -10, 4, 0, 0] }, duration: 0.8, overwrite: true }),
      ),
    );
  });
</script>

<style>
  .land {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas: 'wh wh wh wh co co co co rc rc rc rc';
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 3.5rem);
    min-height: calc(100svh - var(--nav-h) - 15px);
    padding:
      var(--space-y)
      max(var(--gutter), env(safe-area-inset-right))
      var(--space-y)
      max(var(--gutter), env(safe-area-inset-left));
    overflow-x: clip;
  }

  /* ── 이름 ─────────────────────────────── */
  .who { grid-area: wh; display: grid; gap: 1.25rem; align-self: end; }
  .name {
    font-size: clamp(3rem, 6.4vw, 7rem);
    font-weight: var(--w-display);
    letter-spacing: -0.06em;
    line-height: 1.05;
    user-select: none;
  }
  .name { position: relative; width: fit-content; }
  .line { display: block; clip-path: inset(-0.4em -0.2em 0 -0.2em); white-space: nowrap; }
  .ch { display: inline-block; cursor: default; }
  .intro {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.0625rem;
    font-weight: var(--w-text);
    letter-spacing: -0.01em;
    color: var(--ink-soft);
  }
  .intro :global(.flame) { width: 1.4rem; flex: none; color: var(--red); }

  /* ── 대표 이미지 ──────────────────────── */
  .frame {
    grid-area: co;
    justify-self: center;
    position: relative;
    width: min(100%, 26vw, calc((100svh - var(--nav-h) - 2 * var(--space-y)) * 0.75));
    cursor: pointer;
  }
  .art { position: relative; z-index: 1; aspect-ratio: 1600 / 2134; }
  .art :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .cross { position: absolute; z-index: 2; width: 14px; height: 14px; transition: translate var(--dur) var(--ease-spring); }
  .cross { filter: url(#boil); }
  .cross::before, .cross::after { content: ''; position: absolute; background: var(--ink); }
  .cross::before { left: 50%; top: 0; bottom: 0; width: 1px; }
  .cross::after { top: 50%; left: 0; right: 0; height: 1px; }
  .c1 { left: -22px; top: -22px; }
  .c2 { right: -22px; top: -22px; }
  .c3 { left: -22px; bottom: -22px; }
  .c4 { right: -22px; bottom: -22px; }
  @media (hover: hover) {
    .frame:hover .c1 { translate: -8px -8px; }
    .frame:hover .c2 { translate: 8px -8px; }
    .frame:hover .c3 { translate: -8px 8px; }
    .frame:hover .c4 { translate: 8px 8px; }
  }

  .hello {
    position: absolute;
    z-index: 3;
    right: -20%;
    top: 8%;
    display: grid;
    place-items: center;
    width: 8.5rem;
    aspect-ratio: 120 / 90;
    pointer-events: none;
  }
  .hello :global(.hello-bubble) { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--white); color: var(--ink); }
  .hello-text { position: relative; translate: 0 -12%; font-weight: var(--w-display); font-size: 1.25rem; letter-spacing: -0.03em; color: var(--red); }

  /* ── 연락 ─────────────────────────────── */
  .reach {
    grid-area: rc;
    display: grid;
    gap: 1.75rem;
    justify-self: end;
    align-self: end;
    width: min(100%, 22rem);
  }
  .contacts { list-style: none; }
  .row {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3rem;
    text-align: left;
    transition: color var(--dur-fast);
  }
  .row-val { font-size: 0.9375rem; letter-spacing: 0.01em; overflow-wrap: anywhere; }
  .row-end { justify-self: end; transition: transform var(--dur) var(--ease-spring); }
  .row:global(.is-copied) { color: var(--red); }
  @media (hover: hover) {
    .row:hover { color: var(--red); }
    .row:hover .row-end { transform: translateX(4px); }
  }

  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.5rem;
    padding: 0 1.4rem;
    background: var(--red);
    color: var(--white);
  }
  .cta .t-label { letter-spacing: 0.3em; }
  .cta-arrow { font-size: 1.35rem; transition: transform var(--dur) var(--ease-spring); }
  @media (hover: hover) {
    .cta:hover .cta-arrow { transform: translateX(6px) rotate(-20deg); }
  }

  /* ── 태블릿 세로 · 폰 ─────────────────── */
  @media (max-width: 900px) and (orientation: portrait), (max-width: 640px) {
    .land {
      grid-template-areas: 'wh' 'co' 'rc';
      grid-template-columns: 1fr;
      row-gap: clamp(2.5rem, 8vw, 4rem);
      align-items: start;
      padding-block: clamp(2.5rem, 9vw, 4.5rem);
    }
    .name { font-size: clamp(3rem, 17vw, 7rem); }
    .who { align-self: start; }
    .frame { width: min(calc(100vw - 2 * var(--gutter) - 3rem), 26rem); }
    .hello { right: -6%; top: -4%; width: 7rem; }
    .reach { justify-self: stretch; width: 100%; }
  }

  /* ── 가로로 누운 폰 ───────────────────── */
  @media (max-height: 520px) and (orientation: landscape) {
    .name { font-size: clamp(2.5rem, 7vw, 4rem); }
    .frame { width: min(24vw, calc((100svh - var(--nav-h) - 5.5rem) * 0.75)); }
    .land { padding-block: 2.25rem; grid-template-areas: 'wh wh wh co co co co rc rc rc rc rc'; }
    .row { grid-template-columns: 6.25rem 1fr auto; }
    .row .t-label { letter-spacing: 0.1em; }
    .row-val { font-size: 0.8125rem; }
  }
</style>
