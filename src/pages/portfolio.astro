---
// 포트폴리오 — 한 가지 일: 작품을 한 장씩 넘겨 본다.
// 가로 캐러셀(정사각형). 흰 바탕 위에 작품만.
// 넘기기: 화살표 버튼 · 키보드 ←→ · 스와이프 · 마우스 드래그 · 트랙패드 가로 스크롤
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getRoute } from '../lib/site';
import { TYPES, WORKS } from '../data/portfolio';

const route = getRoute('portfolio');
const count = (k: string) => (k === 'all' ? WORKS.length : WORKS.filter((w) => w.type === k).length);
const types = TYPES.filter((t) => count(t.key) > 0);
const typeLabel = Object.fromEntries(TYPES.map((t) => [t.key, t.label]));
const items = WORKS.map((w) => ({
  ...w,
  widths: w.image ? [...[400, 800, 1200].filter((x) => x < w.image!.width), w.image.width] : [],
  color: w.color ?? 'var(--paper-2)',
}));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base route="portfolio" title="Portfolio">

  <div class="page" data-page="portfolio">
    <header class="head wrap">
      <h1 class="t-display title">
        {route.label}<sup class="count" data-count>({items.length})</sup>
      </h1>
      <div class="filters" role="group" aria-label="종류별 보기">
        {types.map((t, i) => (
          <button class="chip sketch sketch-pill t-label" data-filter={t.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {t.label}<span class="chip-n">{count(t.key)}</span>
          </button>
        ))}
      </div>
    </header>

    <section class="carousel" aria-roledescription="carousel" aria-label="작품">
      <ol class="track" data-track tabindex="0" aria-label="작품 목록 — 좌우 화살표로 넘기기">
        {items.map((w, i) => (
          <li class="slide" data-slide data-type={w.type}
              aria-roledescription="slide" aria-label={`${pad(i + 1)} / ${pad(items.length)}`}>
            <button class="media" data-open aria-label={`${w.title} 크게 보기`}
                    style={`--c:${w.color}`}>
              {w.image ? (
                <Image src={w.image} alt={w.title} widths={w.widths}
                       sizes="(max-width: 640px) 84vw, 44vw" loading={i < 3 ? 'eager' : 'lazy'}
                       style={`object-position:${w.focus ?? 'center'}`} draggable="false" />
              ) : (
                <span class="t-label media-ph">{w.title}</span>
              )}
            </button>
            <div class="meta">
              <span class="t-label no" data-no>{pad(i + 1)}</span>
              <h2 class="work-title">{w.title}</h2>
              <span class="t-label t-muted kind">{typeLabel[w.type]}{w.year && ` / ${w.year}`}</span>
            </div>
            <p class="desc">{w.desc}</p>
          </li>
        ))}
      </ol>

      <button class="arrow prev sketch-fill" style="--fill: var(--ink)" data-prev aria-label="이전 작품" data-dark>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
      </button>
      <button class="arrow next sketch-fill" style="--fill: var(--ink)" data-next aria-label="다음 작품" data-dark>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </button>

      <div class="status wrap">
        <span class="t-label" aria-live="polite"><span data-cur>01</span> / <span data-total>{pad(items.length)}</span></span>
        <span class="progress" aria-hidden="true"><span data-progress></span></span>
      </div>
    </section>
  </div>

  <!-- 크게 보기 (원본 비율) -->
  <dialog class="viewer" data-viewer data-dark aria-label="작품 보기">
    <div class="viewer-stage" data-viewer-stage></div>
    <div class="viewer-bar">
      <p class="t-label" data-viewer-caption></p>
      <div class="viewer-ctrl">
        <button class="t-label" data-vprev aria-label="이전">← Prev</button>
        <button class="t-label" data-vnext aria-label="다음">Next →</button>
        <button class="t-label" data-close aria-label="닫기">Close ✕</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import type { MotionEvent } from '../scripts/motion';

  document.addEventListener('motion:ready', (e) => {
    const root = document.querySelector<HTMLElement>('[data-page="portfolio"]');
    if (!root) return;
    const { gsap, reduced, cleanup } = (e as MotionEvent).detail;

    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = gsap.utils.toArray<HTMLElement>('[data-slide]', root);
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const curEl = root.querySelector<HTMLElement>('[data-cur]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const pad = (n: number) => String(n).padStart(2, '0');

    /* ── 위치 계산 ── */
    const visible = () => slides.filter((s) => !s.hidden);
    const startPad = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    const indexNow = () => {
      const list = visible();
      const x = track.scrollLeft + startPad();
      let best = 0, bestD = Infinity;
      list.forEach((s, i) => { const d = Math.abs(s.offsetLeft - x); if (d < bestD) { bestD = d; best = i; } });
      return best;
    };
    const goTo = (i: number) => {
      const list = visible();
      const t = list[Math.max(0, Math.min(list.length - 1, i))];
      if (t) track.scrollTo({ left: t.offsetLeft - startPad(), behavior: reduced ? 'auto' : 'smooth' });
    };

    let idx = -1;
    function update() {
      const list = visible();
      const i = indexNow();
      prevBtn.disabled = i <= 0;
      nextBtn.disabled = i >= list.length - 1;
      const max = Math.max(1, track.scrollWidth - track.clientWidth);
      progress.style.transform = `scaleX(${Math.min(1, (track.scrollLeft + track.clientWidth) / (max + track.clientWidth))})`;
      if (i === idx) return;
      idx = i;
      curEl.textContent = pad(i + 1);
      totalEl.textContent = pad(list.length);
      slides.forEach((s) => s.classList.toggle('is-current', s === list[i]));
    }
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    cleanup(() => window.removeEventListener('resize', update));

    prevBtn.addEventListener('click', () => goTo(indexNow() - 1));
    nextBtn.addEventListener('click', () => goTo(indexNow() + 1));
    track.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') { ev.preventDefault(); goTo(indexNow() + 1); }
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); goTo(indexNow() - 1); }
    });

    /* ── 마우스 드래그로 넘기기 ── */
    let dragging = false, moved = 0, sx = 0, sl = 0;
    track.addEventListener('pointerdown', (ev) => {
      if (ev.pointerType !== 'mouse' || ev.button !== 0) return;
      dragging = true; sx = ev.clientX; sl = track.scrollLeft;
    });
    const onDragMove = (ev: PointerEvent) => {
      if (!dragging) return;
      moved = Math.max(moved, Math.abs(ev.clientX - sx));
      if (moved <= 6) return; // 이 정도는 클릭으로 본다
      track.classList.add('is-dragging');
      track.scrollLeft = sl - (ev.clientX - sx);
    };
    const onDragEnd = (ev: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('is-dragging');
      window.setTimeout(() => (moved = 0), 0); // 드래그 직후의 click 한 번만 막고 초기화
      if (moved <= 6) return;
      const dx = ev.clientX - sx;
      const base = Math.round(indexNow());
      goTo(Math.abs(dx) > 60 ? (dx < 0 ? Math.max(base, idx + 1) : Math.min(base, idx - 1)) : base);
    };
    window.addEventListener('pointermove', onDragMove);
    window.addEventListener('pointerup', onDragEnd);
    cleanup(() => { window.removeEventListener('pointermove', onDragMove); window.removeEventListener('pointerup', onDragEnd); });
    // 드래그 끝에 클릭이 같이 일어나면 무시
    track.addEventListener('click', (ev) => { if (moved > 6) { ev.stopPropagation(); ev.preventDefault(); } }, true);

    /* ── 필터 ── */
    const chips = gsap.utils.toArray<HTMLButtonElement>('[data-filter]', root);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const shown = slides.filter((li) => { const on = key === 'all' || li.dataset.type === key; li.hidden = !on; return on; });
        shown.forEach((li, i) => (li.querySelector('[data-no]')!.textContent = pad(i + 1)));
        countEl.textContent = `(${shown.length})`;
        track.scrollLeft = 0;
        idx = -1;
        update();
        if (!reduced) gsap.fromTo(shown.slice(0, 4), { autoAlpha: 0, x: 40 }, { autoAlpha: 1, x: 0, duration: 0.7, stagger: 0.06, ease: 'expo.out', clearProps: 'opacity,visibility,transform' });
      }),
    );

    /* ── 등장 ── */
    update();
    if (!reduced) {
      gsap.timeline({ defaults: { ease: 'expo.out' } })
        .from('.title', { yPercent: 40, autoAlpha: 0, duration: 1 })
        .from('.chip', { y: 12, autoAlpha: 0, duration: 0.6, stagger: 0.05 }, 0.2)
        // 끝나면 인라인 스타일을 지워 CSS(현재 작품 강조, 비활성 화살표 숨김)가 다시 맡게 한다
        .from(slides.slice(0, 4), { x: 80, autoAlpha: 0, duration: 1.1, stagger: 0.08, clearProps: 'opacity,visibility,transform' }, 0.2)
        .from(['.arrow', '.status'], { autoAlpha: 0, duration: 0.6, clearProps: 'opacity,visibility' }, 0.8);
    }

    /* ── 크게 보기 (원본 비율) ── */
    const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-viewer-stage]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-viewer-caption]')!;
    let vi = 0;
    function show(i: number) {
      const list = visible();
      vi = (i + list.length) % list.length;
      const li = list[vi];
      const src = li.querySelector('img');
      const img = new Image();
      if (src) { img.src = src.currentSrc || src.src; img.srcset = src.srcset; img.sizes = '100vw'; img.alt = src.alt; }
      stage.replaceChildren(img);
      caption.textContent = `${pad(vi + 1)} / ${pad(list.length)} — ${li.querySelector('.work-title')!.textContent}`;
      if (!reduced) gsap.fromTo(img, { autoAlpha: 0, scale: 0.97 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'expo.out' });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const li = btn.closest<HTMLElement>('[data-slide]')!;
        const list = visible();
        // 맨 앞 작품이 아니면 먼저 그 작품으로 넘기고, 맨 앞이면 크게 본다
        if (li !== list[indexNow()]) { goTo(list.indexOf(li)); return; }
        show(list.indexOf(li));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-vprev]')!.addEventListener('click', () => show(vi - 1));
    dialog.querySelector('[data-vnext]')!.addEventListener('click', () => show(vi + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (ev) => { if (ev.target === dialog || ev.target === stage) dialog.close(); });
    dialog.addEventListener('close', () => goTo(vi));
    const onKey = (ev: KeyboardEvent) => {
      if (dialog.open) {
        if (ev.key === 'ArrowLeft') show(vi - 1);
        if (ev.key === 'ArrowRight') show(vi + 1);
        return;
      }
      // 트랙에 포커스가 없어도 ←→ 로 넘기기
      if (document.activeElement === track || (ev.target as HTMLElement).closest('input, textarea')) return;
      if (ev.key === 'ArrowRight') goTo(indexNow() + 1);
      if (ev.key === 'ArrowLeft') goTo(indexNow() - 1);
    };
    document.addEventListener('keydown', onKey);
    let tx = 0;
    stage.addEventListener('touchstart', (ev) => { tx = ev.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (ev) => {
      const dx = ev.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 50) show(vi + (dx < 0 ? 1 : -1));
    });
    cleanup(() => { document.removeEventListener('keydown', onKey); if (dialog.open) dialog.close(); });
  });
</script>

<style>
  .page { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; min-width: 0; }

  /* ── 머리 ───────────────────────────────── */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: var(--space-y) clamp(2.5rem, 7svh, 4.5rem);
  }
  .title { position: relative; font-size: clamp(2.5rem, 5.6vw, 5.5rem); }
  .count { font-size: 0.22em; font-weight: var(--w-text); letter-spacing: 0; vertical-align: top; margin-left: 0.2em; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    isolation: isolate;
    transition: background-color var(--dur-fast), color var(--dur-fast), rotate var(--dur) var(--ease-spring);
  }
  .chip-n { opacity: 0.55; }
  .chip[aria-pressed='true'] { color: var(--white); }
  .chip[aria-pressed='true']::after {
    content: '';
    position: absolute;
    inset: 3px 2px;
    z-index: -1;
    background: var(--ink);
    -webkit-mask: url('../assets/sketch/pill-fill.svg') 0 0 / 100% 100% no-repeat;
    mask: url('../assets/sketch/pill-fill.svg') 0 0 / 100% 100% no-repeat;
  }
  @media (hover: hover) { .chip:hover { rotate: -3deg; } }

  /* ── 캐러셀 ─────────────────────────────── */
  .carousel {
    --size: min(36vw, calc(100svh - var(--nav-h) - 26rem));
    --gap: clamp(1.25rem, 3.2vw, 3.5rem);
    position: relative;
    min-width: 0; /* flex 자식이 내용 폭만큼 늘어나지 않게 → 트랙이 스크롤됨 */
  }
  .track {
    list-style: none;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    padding-bottom: 0.5rem;
    scrollbar-width: none;
    cursor: grab;
    outline-offset: -2px;
  }
  .track::-webkit-scrollbar { display: none; }
  .track::after { content: ''; flex: 0 0 calc(100vw - var(--size) - 2 * var(--gutter)); } /* 마지막 작품도 맨 앞에 설 수 있게 */
  .track:global(.is-dragging) { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .track:global(.is-dragging) .media { pointer-events: none; }

  .slide {
    flex: 0 0 var(--size);
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    transition: opacity var(--dur) linear;
  }
  .slide:not(:global(.is-current)) { opacity: 0.35; }
  .slide:global(.is-current) { opacity: 1; }

  .media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--c);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
    -webkit-user-drag: none;
  }
  @media (hover: hover) {
    .slide:global(.is-current) .media:hover :global(img) { transform: scale(1.03); }
  }
  .media-ph { position: absolute; left: 0.9rem; top: 0.9rem; color: var(--white); }

  .meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding-top: 0.6rem;
  }
  .work-title { font-size: var(--fs-body); font-weight: var(--w-title); letter-spacing: -0.01em; }
  .slide:global(.is-current) .work-title { color: var(--red); }
  .desc { font-size: 0.875rem; line-height: 1.55; color: var(--ink-soft); max-width: 34em; }

  /* 이전/다음 — 이미지 세로 가운데의 검정 네모 */
  .arrow {
    position: absolute;
    top: calc(var(--size) / 2);
    translate: 0 -50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--ink);
    color: var(--white);
    transition: opacity var(--dur-fast), transform var(--dur) var(--ease-spring);
  }
  .arrow svg { width: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .prev { left: calc(max(var(--gutter), env(safe-area-inset-left)) - 1.375rem); }
  .next { right: calc(max(var(--gutter), env(safe-area-inset-right)) - 1.375rem); }
  .arrow:disabled { opacity: 0; pointer-events: none; }
  @media (hover: hover) {
    .prev:hover { transform: translateX(-3px); }
    .next:hover { transform: translateX(3px); }
  }

  .status {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(2rem, 5svh, 3.5rem);
  }
  .progress { flex: 1; max-width: 16rem; height: 1.5px; background: var(--line); position: relative; filter: url(#boil-thin); }
  .progress span {
    position: absolute;
    inset: -1px 0;
    background: var(--ink);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  /* ── 폰 ─────────────────────────────────── */
  @media (max-width: 640px) {
    .carousel { --size: calc(100vw - 2 * var(--gutter) - 1.5rem); }
    .prev { left: calc(var(--gutter) / 2); }
    .next { right: calc(var(--gutter) / 2); }
    .head { align-items: flex-start; flex-direction: column; }
  }
  /* 터치 기기는 스와이프가 기본이라 버튼을 작게 */
  @media (hover: none) {
    .arrow { opacity: 0.85; }
  }
  /* 높이가 낮은 화면(가로 폰) */
  @media (max-height: 520px) and (orientation: landscape) {
    .carousel { --size: min(40vw, calc(100svh - var(--nav-h) - 6rem)); }
    .head { padding-block: 1rem; }
    .title { font-size: 2.5rem; }
    }

  /* ── 크게 보기 ───────────────────────────── */
  .viewer {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    background: color-mix(in oklab, var(--ink) 94%, transparent);
    color: var(--white);
    display: none;
    flex-direction: column;
  }
  .viewer[open] { display: flex; }
  .viewer::backdrop { background: transparent; }
  .viewer-stage {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    padding-top: max(clamp(1rem, 4vw, 3rem), env(safe-area-inset-top));
  }
  .viewer-stage :global(img) { max-width: 100%; max-height: calc(100dvh - 9rem); width: auto; height: auto; object-fit: contain; }
  .viewer-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 1rem var(--gutter) calc(1rem + env(safe-area-inset-bottom));
    border-top: 1px solid color-mix(in oklab, var(--white) 25%, transparent);
  }
  .viewer-ctrl { display: flex; gap: 0.5rem; }
  .viewer-ctrl button { min-height: 2.75rem; padding: 0 0.9rem; }
  @media (hover: hover) { .viewer-ctrl button:hover { color: var(--red); } }
</style>
